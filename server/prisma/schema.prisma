generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum GstRate {
  GST_0
  GST_5
  GST_12
  GST_18
  GST_28
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  STORE_CREDIT
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  DEFECTIVE
}

enum CreditNoteStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum InventoryItemStatus {
  AVAILABLE
  SOLD
  RETURNED
  DAMAGED
  RESERVED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  OPENING_STOCK
}

enum AdjustmentReason {
  PHYSICAL_COUNT
  DAMAGE
  EXPIRED
  LOST
  CORRECTION
  MANUAL_ADJUSTMENT
  OPENING_STOCK
  SALE_CORRECTION
  RETURNED
}

enum PurchaseStatus {
  DRAFT
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  ELECTRICITY
  MAINTENANCE
  TRANSPORTATION
  MARKETING
  PACKAGING
  MISCELLANEOUS
}

// ──────────────────────────────────────────────
// STORE
// ──────────────────────────────────────────────

model Store {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  code          String    @unique
  ownerName     String?
  panNumber     String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  phone         String?
  email         String?
  website       String?
  gstin         String?
  logo          String?
  currency      String    @default("INR")
  timezone      String    @default("Asia/Kolkata")
  language      String    @default("en")
  financialYear String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  users           User[]
  categories      Category[]
  brands          Brand[]
  productVariants ProductVariant[]
  suppliers       Supplier[]
  customers       Customer[]
  purchases       Purchase[]
  sales           Sale[]
  salesReturns    SalesReturn[]
  creditNotes     CreditNote[]
  stockMovements  StockMovement[]
  expenses        Expense[]
  invoiceSetting  InvoiceSetting?
  gstSetting      GstSetting?
  barcodeSetting  BarcodeSetting?
  printerSetting  PrinterSetting?
  backups         Backup[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  InventoryItem   InventoryItem[]

  @@index([code])
  @@index([isActive])
  @@map("stores")
}

// ──────────────────────────────────────────────
// SETTINGS
// ──────────────────────────────────────────────

model InvoiceSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  storeId            String   @unique @db.Uuid
  prefix             String   @default("INV")
  startingNumber     Int      @default(1)
  receiptFooter      String?
  termsAndConditions String?
  thankYouMessage    String?
  a4Template         String?
  thermal58Template  String?
  thermal80Template  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("invoice_settings")
}

model GstSetting {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @unique @db.Uuid
  isGstEnabled  Boolean  @default(true)
  defaultMode   String   @default("EXCLUSIVE")
  rate0Enabled  Boolean  @default(true)
  rate5Enabled  Boolean  @default(true)
  rate12Enabled Boolean  @default(true)
  rate18Enabled Boolean  @default(true)
  rate28Enabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("gst_settings")
}

model BarcodeSetting {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @unique @db.Uuid
  barcodeType  String   @default("CODE128")
  labelWidth   Int      @default(50)
  labelHeight  Int      @default(30)
  labelsPerRow Int      @default(2)
  showPrice    Boolean  @default(true)
  showSku      Boolean  @default(true)
  showVariant  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("barcode_settings")
}

model PrinterSetting {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @unique @db.Uuid
  printerType String   @default("thermal") // thermal | a4
  printerName String?
  paperSize   String   @default("80mm") // 58mm | 80mm | A4
  margins     Int      @default(5)
  fontSize    Int      @default(12)
  autoPrint   Boolean  @default(true)
  copies      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("printer_settings")
}

// ──────────────────────────────────────────────
// USER PREFERENCES
// ──────────────────────────────────────────────

model UserPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  theme                String   @default("light")
  language             String   @default("en")
  defaultLandingPage   String   @default("/")
  defaultPrinter       String?
  defaultPaymentMethod String?
  itemsPerPage         Int      @default(20)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ──────────────────────────────────────────────
// AUDIT LOG
// ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  module    String
  recordId  String?
  details   Json?
  ipAddress String?
  storeId   String?  @db.Uuid
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([storeId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  type      String   @default("info") // info | warning | success | error
  isRead    Boolean  @default(false)
  link      String?
  storeId   String?  @db.Uuid
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationSetting {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  lowStockAlert     Boolean  @default(true)
  outOfStockAlert   Boolean  @default(true)
  dailySalesSummary Boolean  @default(false)
  newUserAlert      Boolean  @default(true)
  backupAlert       Boolean  @default(true)
  emailEnabled      Boolean  @default(false)
  smsEnabled        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ──────────────────────────────────────────────
// BACKUP
// ──────────────────────────────────────────────

model Backup {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  filename    String
  filePath    String
  fileSize    Int?
  status      String   @default("COMPLETED") // COMPLETED | FAILED | RESTORED
  notes       String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation("BackupCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@index([createdAt])
  @@map("backups")
}

// ──────────────────────────────────────────────
// AUTHENTICATION & AUTHORIZATION
// ──────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String?
  isActive     Boolean   @default(true)
  storeId      String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  store                  Store?               @relation(fields: [storeId], references: [id])
  userRoles              UserRole[]
  createdUsers           User[]               @relation("UserCreatedBy")
  createdById            String?              @db.Uuid
  createdBy              User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  purchases              Purchase[]           @relation("PurchaseCreatedBy")
  sales                  Sale[]               @relation("SaleCreatedBy")
  salesReturns           SalesReturn[]        @relation("ReturnCreatedBy")
  refundProcessedReturns SalesReturn[]        @relation("RefundProcessedBy")
  stockMovements         StockMovement[]      @relation("StockCreatedBy")
  expenses               Expense[]            @relation("ExpenseCreatedBy")
  creditNotesCreated     CreditNote[]         @relation("CreditNoteCreatedBy")
  backupsCreated         Backup[]             @relation("BackupCreatedBy")
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationSetting    NotificationSetting?
  userPreference         UserPreference?
  refreshTokens          RefreshToken[]

  @@index([email])
  @@index([storeId])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ──────────────────────────────────────────────
// PRODUCT CATALOG
// ──────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  parentId    String?   @db.Uuid
  storeId     String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  store    Store?     @relation(fields: [storeId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([storeId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  storeId     String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  store    Store?    @relation(fields: [storeId], references: [id])
  products Product[]

  @@index([slug])
  @@index([storeId])
  @@map("brands")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  tags        String[]
  categoryId  String    @db.Uuid
  brandId     String?   @db.Uuid
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @db.Uuid
  sku              String
  barcode          String    @unique
  barcodeType      String    @default("CODE128")
  barcodeImagePath String?
  size             String?
  color            String?
  fabric           String?
  rackLocation     String?
  purchasePrice    Decimal   @db.Decimal(10, 2)
  sellingPrice     Decimal   @db.Decimal(10, 2)
  mrp              Decimal?  @db.Decimal(10, 2)
  gstPercentage    GstRate   @default(GST_18)
  stockQuantity    Int       @default(0)
  reorderLevel     Int       @default(0)
  isActive         Boolean   @default(true)
  storeId          String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  product        Product           @relation(fields: [productId], references: [id])
  store          Store?            @relation(fields: [storeId], references: [id])
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  returnItems    SalesReturnItem[]
  stockMovements StockMovement[]
  inventoryItems InventoryItem[]

  @@unique([productId, sku])
  @@unique([productId, size, color, fabric])
  @@index([barcode])
  @@index([sku])
  @@index([productId])
  @@index([storeId])
  @@index([isActive])
  @@index([size, color])
  @@map("product_variants")
}

// ──────────────────────────────────────────────
// INVENTORY ITEM (one physical piece)
// ──────────────────────────────────────────────

model InventoryItem {
  id           String              @id @default(uuid()) @db.Uuid
  barcode          String              @unique
  barcodeImagePath String?
  variantId        String              @db.Uuid
  storeId          String              @db.Uuid
  serialNumber     String?
  status       InventoryItemStatus @default(AVAILABLE)
  saleId       String?             @db.Uuid
  saleItemId   String?             @db.Uuid
  soldAt       DateTime?
  returnedAt   DateTime?
  returnReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  productVariant ProductVariant @relation(fields: [variantId], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  sale           Sale?          @relation(fields: [saleId], references: [id])
  saleItem       SaleItem?      @relation(fields: [saleItemId], references: [id])

  @@index([barcode])
  @@index([variantId])
  @@index([status])
  @@index([storeId])
  @@index([variantId, status])
  @@index([saleId])
  @@map("inventory_items")
}

// ──────────────────────────────────────────────
// SUPPLIER
// ──────────────────────────────────────────────

model Supplier {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  contactPerson String?
  email         String?
  phone         String?   @unique
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?   @unique
  isActive      Boolean   @default(true)
  storeId       String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  store     Store?     @relation(fields: [storeId], references: [id])
  purchases Purchase[]

  @@index([email])
  @@index([phone])
  @@index([storeId])
  @@map("suppliers")
}

// ──────────────────────────────────────────────
// CUSTOMER
// ──────────────────────────────────────────────

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  loyaltyPoints Int       @default(0)
  storeId       String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  store       Store?       @relation(fields: [storeId], references: [id])
  sales       Sale[]
  creditNotes CreditNote[]

  @@index([email])
  @@index([phone])
  @@index([storeId])
  @@map("customers")
}

// ──────────────────────────────────────────────
// PURCHASE
// ──────────────────────────────────────────────

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  invoiceNumber  String         @unique
  supplierId     String         @db.Uuid
  purchaseDate   DateTime       @default(now())
  subtotal       Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  paymentMode    PaymentMode?
  notes          String?
  storeId        String         @db.Uuid
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  store     Store          @relation(fields: [storeId], references: [id])
  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([storeId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseId       String   @db.Uuid
  productVariantId String   @db.Uuid
  quantity         Int
  unitCost         Decimal  @db.Decimal(10, 2)
  totalCost        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchase       Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([purchaseId])
  @@index([productVariantId])
  @@map("purchase_items")
}

// ──────────────────────────────────────────────
// SALE
// ──────────────────────────────────────────────

model Sale {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceNumber  String    @unique
  customerId     String?   @db.Uuid
  saleDate       DateTime  @default(now())
  subtotal       Decimal   @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @db.Decimal(12, 2)
  isGst          Boolean   @default(true)
  notes          String?
  storeId        String    @db.Uuid
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customer              Customer?              @relation(fields: [customerId], references: [id])
  store                 Store                  @relation(fields: [storeId], references: [id])
  createdBy             User                   @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items                 SaleItem[]
  payments              SalePayment[]
  returns               SalesReturn[]
  inventoryItems        InventoryItem[]
  creditNoteRedemptions CreditNoteRedemption[]
  creditNotesOriginal   CreditNote[]           @relation("CreditNoteOriginalSale")

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([saleDate])
  @@index([storeId])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @db.Uuid
  productVariantId String   @db.Uuid
  quantity         Int
  unitPrice        Decimal  @db.Decimal(10, 2)
  gstPercentage    Int      @default(18)
  gstAmount        Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id])
  returnItems    SalesReturnItem[]
  inventoryItems InventoryItem[]

  @@index([saleId])
  @@index([productVariantId])
  @@map("sale_items")
}

model SalePayment {
  id        String      @id @default(uuid()) @db.Uuid
  saleId    String      @db.Uuid
  mode      PaymentMode
  amount    Decimal     @db.Decimal(12, 2)
  reference String?
  createdAt DateTime    @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

// ──────────────────────────────────────────────
// SALES RETURN
// ──────────────────────────────────────────────

model SalesReturn {
  id                  String       @id @default(uuid()) @db.Uuid
  returnNumber        String       @unique
  saleId              String       @db.Uuid
  returnDate          DateTime     @default(now())
  totalAmount         Decimal      @db.Decimal(12, 2)
  reason              String?
  refundMethod        PaymentMode?
  refundAmount        Decimal?     @db.Decimal(12, 2)
  refundDate          DateTime?
  refundProcessedById String?      @db.Uuid
  storeId             String       @db.Uuid
  createdById         String       @db.Uuid
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  sale              Sale              @relation(fields: [saleId], references: [id])
  store             Store             @relation(fields: [storeId], references: [id])
  createdBy         User              @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  refundProcessedBy User?             @relation("RefundProcessedBy", fields: [refundProcessedById], references: [id])
  items             SalesReturnItem[]
  creditNotes       CreditNote[]

  @@index([returnNumber])
  @@index([saleId])
  @@index([storeId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id               String          @id @default(uuid()) @db.Uuid
  salesReturnId    String          @db.Uuid
  saleItemId       String          @db.Uuid
  productVariantId String          @db.Uuid
  quantity         Int
  unitPrice        Decimal         @db.Decimal(10, 2)
  totalAmount      Decimal         @db.Decimal(12, 2)
  reason           String?
  condition        ReturnCondition @default(RESELLABLE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  salesReturn    SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([salesReturnId])
  @@index([saleItemId])
  @@index([productVariantId])
  @@map("sales_return_items")
}

model CreditNote {
  id               String           @id @default(uuid()) @db.Uuid
  creditNoteNumber String           @unique
  customerId       String?          @db.Uuid
  salesReturnId    String?          @db.Uuid
  originalSaleId   String?          @db.Uuid
  amount           Decimal          @db.Decimal(12, 2)
  availableAmount  Decimal          @db.Decimal(12, 2)
  issueDate        DateTime         @default(now())
  expiryDate       DateTime?
  status           CreditNoteStatus @default(ACTIVE)
  redeemedAt       DateTime?
  notes            String?
  storeId          String           @db.Uuid
  createdById      String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  customer     Customer?              @relation(fields: [customerId], references: [id])
  salesReturn  SalesReturn?           @relation(fields: [salesReturnId], references: [id])
  originalSale Sale?                  @relation("CreditNoteOriginalSale", fields: [originalSaleId], references: [id])
  store        Store                  @relation(fields: [storeId], references: [id])
  createdBy    User                   @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  redemptions  CreditNoteRedemption[]

  @@index([creditNoteNumber])
  @@index([customerId])
  @@index([status])
  @@map("credit_notes")
}

model CreditNoteRedemption {
  id           String   @id @default(uuid()) @db.Uuid
  creditNoteId String   @db.Uuid
  saleId       String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  sale       Sale       @relation(fields: [saleId], references: [id])

  @@index([creditNoteId])
  @@index([saleId])
  @@map("credit_note_redemptions")
}

// ──────────────────────────────────────────────
// STOCK MOVEMENT
// ──────────────────────────────────────────────

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  productVariantId  String            @db.Uuid
  quantity          Int
  type              StockMovementType
  previousStock     Int               @default(0)
  newStock          Int               @default(0)
  adjustmentReason  AdjustmentReason?
  purchaseItemId    String?           @db.Uuid
  saleItemId        String?           @db.Uuid
  salesReturnItemId String?           @db.Uuid
  notes             String?
  storeId           String            @db.Uuid
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  createdBy      User           @relation("StockCreatedBy", fields: [createdById], references: [id])

  @@index([productVariantId])
  @@index([type])
  @@index([storeId])
  @@index([createdAt])
  @@index([productVariantId, createdAt])
  @@map("stock_movements")
}

// ──────────────────────────────────────────────
// EXPENSE
// ──────────────────────────────────────────────

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  date        DateTime        @default(now())
  paymentMode PaymentMode?
  storeId     String          @db.Uuid
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([category])
  @@index([date])
  @@index([storeId])
  @@map("expenses")
}
