# Server
SERVER_PORT=4000
SERVER_NODE_ENV=development

# Database
DATABASE_URL="postgresql://central_one:central123@localhost:5432/central_one?schema=public"

# JWT Access Token (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token (generate with: openssl rand -hex 64)
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=5242880

# CORS (comma-separated for multiple origins in production)
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:4000/api